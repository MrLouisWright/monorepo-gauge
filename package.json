{
  "name": "monorepo-gauge",
  "version": "1.0.0",
  "description": "Hygiene checks for npm/yarn/pnpm workspaces: circular internal dependencies, internal ranges that no longer match, shared dependency drift, duplicate names, public packages depending on private ones, per-package field checks via pkg-field-gauge, workspace: protocol consistency, syncpack-style version groups and version drift. Text/JSON/SARIF/Markdown, allowlist with expiry, GitHub Action. --fix for ranges and versions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "monorepo-gauge": "bin/monorepo-gauge.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "monorepo",
    "workspaces",
    "pnpm",
    "yarn",
    "npm",
    "lerna",
    "dependencies",
    "lint",
    "sarif",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/monorepo-gauge.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/monorepo-gauge/issues"
  },
  "homepage": "https://mrlouiswright.github.io/monorepo-gauge/",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "pkg-field-gauge": "^1.0.1"
  }
}
